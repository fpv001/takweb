{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix app ci",
  "buildCommand": "npm --prefix app run build && node scripts/copiar-sitio.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/db/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/security/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/server.mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.gitignore",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/dashboard",
      "destination": "/admin"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/admin"
    },
    {
      "source": "/tip/:id",
      "destination": "/api/tip?id=:id"
    },
    {
      "source": "/r/:id",
      "destination": "/api/tip?id=:id&k=r"
    },
    {
      "source": "/k/:id",
      "destination": "/api/tip?id=:id&k=k"
    },
    {
      "source": "/r/:path*",
      "destination": "/admin"
    },
    {
      "source": "/k/:path*",
      "destination": "/admin"
    }
  ],
  "functions": {
    "api/tip.js": {
      "includeFiles": "admin/index.html"
    },
    "api/og.js": {
      "includeFiles": "{api/_fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/@resvg/resvg-js-linux-x64-gnu/**}"
    }
  }
}
