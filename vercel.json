{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/dashboard",
      "destination": "/admin"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/admin"
    },
    {
      "source": "/tip/:path*",
      "destination": "/admin"
    }
  ]
}
